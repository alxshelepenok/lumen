---
import styles from "@/assets/styles/modules/button.module.scss";

import { withTrailingSlash } from "@/utils/with-trailing-slash";

interface Props {
  className?: string;
  title: string;
  to: string;
}

const { className, title, to } = Astro.props;
---

<a class={[styles.button, className].filter(Boolean).join(" ")} href={withTrailingSlash(to)}>
  {title}
</a>

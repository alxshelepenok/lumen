---
import styles from "@/assets/styles/modules/post-footer.module.scss";

interface Props {
  date: Date;
}

const { date } = Astro.props;

const published = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<div class={styles.postFooter}>
  <p class={styles.date}>Published {published}</p>
</div>

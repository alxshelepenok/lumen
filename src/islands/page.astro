---
import styles from "@/assets/styles/modules/page.module.scss";

interface Props {
  heading?: string;
  title?: string;
}

const { heading = "Articles", title } = Astro.props;
---

<section class={styles.page} aria-labelledby="page-title">
  {
    title ? (
      <h1 id="page-title" class={styles.title}>
        {title}
      </h1>
    ) : (
      <h1 id="page-title" class="visually-hidden">
        {heading}
      </h1>
    )
  }
  <slot />
</section>

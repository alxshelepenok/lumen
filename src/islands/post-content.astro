---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import styles from "@/assets/styles/modules/post-content.module.scss";

interface Props {
  Content: AstroComponentFactory;
  title: string;
}

const { Content, title } = Astro.props;
---

<div class={styles.postContent}>
  <h1 id="post-title" class={styles.title}>{title}</h1>
  <div class={styles.body}>
    <Content />
  </div>
</div>

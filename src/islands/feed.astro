---
import styles from "@/assets/styles/modules/feed.module.scss";

import type { FeedItem } from "@/utils/get-feed-items";
import { toKebabCase } from "@/utils/routes";

interface Props {
  items: FeedItem[];
}

const { items } = Astro.props;

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long" });

const formatDateTime = (date: Date): string => date.toISOString();
---

<section id="articles" class={styles.feed} aria-labelledby="feed-heading">
  <h2 id="feed-heading" class="visually-hidden">Articles</h2>
  {
    items.map((item) => (
      <article class={styles.item} id={`article-${toKebabCase(item.title)}`}>
        <header class={styles.meta}>
          <time class={styles.time} datetime={formatDateTime(item.date)}>
            {formatDate(item.date)}
          </time>
          <span class={styles.divider} />
          <span class={styles.category}>
            {item.category && item.categorySlug ? (
              <a href={item.categorySlug} class={styles.link}>
                {item.category}
              </a>
            ) : null}
          </span>
        </header>
        <h3 class={styles.title}>
          <a class={styles.link} href={item.slug}>
            {item.title}
          </a>
        </h3>
        <p class={styles.description}>{item.description}</p>
        <a
          class={styles.more}
          href={item.slug}
          aria-label={`Read more about ${item.title}`}
        >
          Read
        </a>
      </article>
    ))
  }
</section>

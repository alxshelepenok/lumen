---
import styles from "@/assets/styles/modules/feed.module.scss";

import type { FeedItem } from "@/utils/get-feed-items";

interface Props {
  items: FeedItem[];
}

const { items } = Astro.props;

const formatDate = (date: Date): string =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long" });

const formatDateTime = (date: Date): string =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<div class={styles.feed}>
  {
    items.map((item) => (
      <div class={styles.item}>
        <div class={styles.meta}>
          <time class={styles.time} datetime={formatDateTime(item.date)}>
            {formatDate(item.date)}
          </time>
          <span class={styles.divider} />
          <span class={styles.category}>
            {item.category && item.categorySlug ? (
              <a href={item.categorySlug} class={styles.link}>
                {item.category}
              </a>
            ) : null}
          </span>
        </div>
        <h2 class={styles.title}>
          <a class={styles.link} href={item.slug}>
            {item.title}
          </a>
        </h2>
        <p class={styles.description}>{item.description}</p>
        <a class={styles.more} href={item.slug}>
          Read
        </a>
      </div>
    ))
  }
</div>

---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import styles from "@/assets/styles/modules/post.module.scss";

import Button from "@/islands/button.astro";
import PostAuthor from "@/islands/post-author.astro";
import PostFooter from "@/islands/post-footer.astro";
import PostTags from "@/islands/post-tags.astro";
import ThemeToggle from "@/islands/theme-toggle.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { toKebabCase } from "@/utils/routes";

interface Props {
  post: {
    Content: AstroComponentFactory;
    date: Date;
    tagSlugs?: string[];
    tags?: string[];
    title: string;
  };
}

const { post } = Astro.props;

const { Content } = post;
const { title: siteTitle } = getSiteMetadata();
---

<article id="article" class={styles.post} aria-labelledby="post-title">
  <header>
    <nav id="breadcrumb" class="visually-hidden" aria-label="Breadcrumb">
      <ol>
        <li id={`breadcrumb-item-${toKebabCase(siteTitle)}`}>
          <a href="/">{siteTitle}</a>
        </li>
        <li id={`breadcrumb-item-${toKebabCase(post.title)}`} aria-current="page">
          {post.title}
        </li>
      </ol>
    </nav>
    <div class={styles.buttons}>
      <Button className={styles.buttonArticles} title="All Articles" to="/" />
      <ThemeToggle />
    </div>
    <hgroup class={styles.titleWrap}>
      <h1 id="post-title" class={styles.title}>{post.title}</h1>
    </hgroup>
  </header>
  <section id="post-body" class={styles.body} aria-labelledby="post-title">
    <Content />
  </section>
  <footer class={styles.footer}>
    <PostFooter date={post.date} />
    {
      post.tags && post.tagSlugs ? (
        <PostTags tags={post.tags} tagSlugs={post.tagSlugs} />
      ) : null
    }
    <PostAuthor />
  </footer>
</article>

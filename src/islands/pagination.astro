---
import styles from "@/assets/styles/modules/pagination.module.scss";
import { labels } from "@/constants/labels";
import { pagination } from "@/constants/pagination";
import { Route, SLICE } from "@/utils/routes";


interface Props {
  prevPagePath: string;
  nextPagePath: string;
  hasNextPage: boolean;
  hasPrevPage: boolean;
}

const { prevPagePath, nextPagePath, hasNextPage, hasPrevPage } = Astro.props;

const prevHref = new Route(prevPagePath).anchor(SLICE.page);
const nextHref = new Route(nextPagePath).anchor(SLICE.page);

const prevClassName = hasPrevPage
  ? styles.previousLink
  : `${styles.previousLink} ${styles.disable}`;

const nextClassName = hasNextPage
  ? styles.nextLink
  : `${styles.nextLink} ${styles.disable}`;
---

<nav class={styles.pagination} aria-label={labels.pagination}>
  {
    hasPrevPage ? (
      <a rel="prev" href={prevHref} class={prevClassName}>
        <div class={styles.label}>{pagination.prevPage}</div>
      </a>
    ) : (
      <span class={prevClassName}>
        <div class={styles.label}>{pagination.prevPage}</div>
      </span>
    )
  }
  {
    hasNextPage ? (
      <a rel="next" href={nextHref} class={nextClassName}>
        <div class={styles.label}>{pagination.nextPage}</div>
      </a>
    ) : (
      <span class={nextClassName}>
        <div class={styles.label}>{pagination.nextPage}</div>
      </span>
    )
  }
</nav>

---
import { pagination } from "@/constants/pagination";
import styles from "@/assets/styles/modules/pagination.module.scss";

import { withTrailingSlash } from "@/utils/with-trailing-slash";

interface Props {
  prevPagePath: string;
  nextPagePath: string;
  hasNextPage: boolean;
  hasPrevPage: boolean;
}

const { prevPagePath, nextPagePath, hasNextPage, hasPrevPage } = Astro.props;

const prevClassName = hasPrevPage
  ? styles.previousLink
  : `${styles.previousLink} ${styles.disable}`;

const nextClassName = hasNextPage
  ? styles.nextLink
  : `${styles.nextLink} ${styles.disable}`;
---

<div class={styles.pagination}>
  <div class={styles.previous}>
    <a rel="prev" href={withTrailingSlash(hasPrevPage ? prevPagePath : "/")} class={prevClassName}>
      {pagination.prevPage}
    </a>
  </div>
  <div class={styles.next}>
    <a rel="next" href={withTrailingSlash(hasNextPage ? nextPagePath : "/")} class={nextClassName}>
      {pagination.nextPage}
    </a>
  </div>
</div>

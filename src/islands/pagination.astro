---
import styles from "@/assets/styles/modules/pagination.module.scss";
import { pagination } from "@/constants/pagination";


interface Props {
  prevPagePath: string;
  nextPagePath: string;
  hasNextPage: boolean;
  hasPrevPage: boolean;
}

const { prevPagePath, nextPagePath, hasNextPage, hasPrevPage } = Astro.props;

const prevClassName = hasPrevPage
  ? styles.previousLink
  : `${styles.previousLink} ${styles.disable}`;

const nextClassName = hasNextPage
  ? styles.nextLink
  : `${styles.nextLink} ${styles.disable}`;
---

<nav class={styles.pagination} aria-label="Pagination">
  {
    hasPrevPage ? (
      <a rel="prev" href={prevPagePath} class={prevClassName}>
        {pagination.prevPage}
      </a>
    ) : (
      <span class={prevClassName}>{pagination.prevPage}</span>
    )
  }
  {
    hasNextPage ? (
      <a rel="next" href={nextPagePath} class={nextClassName}>
        {pagination.nextPage}
      </a>
    ) : (
      <span class={nextClassName}>{pagination.nextPage}</span>
    )
  }
</nav>

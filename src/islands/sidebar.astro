---
import styles from "@/assets/styles/modules/sidebar.module.scss";

import SidebarAuthor from "@/islands/sidebar-author.astro";
import SidebarContacts from "@/islands/sidebar-contacts.astro";
import SidebarCopyright from "@/islands/sidebar-copyright.astro";
import SidebarMenu from "@/islands/sidebar-menu.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";

const { author, copyright, menu } = getSiteMetadata();
---

<aside class={styles.sidebar} aria-labelledby="sidebar-author-heading">
  <SidebarAuthor author={author} />
  <SidebarMenu menu={menu} />
  <SidebarContacts contacts={author.contacts} />
  <SidebarCopyright copyright={copyright} />
</aside>

---
import "@/assets/styles/main.scss";

import IconSprite from "@/islands/icon-sprite.astro";
import Meta from "@/islands/meta.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { Route } from "@/utils/routes";
import { themeStorageKey } from "@/utils/theme";

interface Props {
  description?: string;
  image?: string;
  title: string;
}

const { description = "", image, title } = Astro.props;
const { googleAnalyticsId } = getSiteMetadata();

const canonical = new Route(Astro.url.pathname).canonical(
  Astro.site?.href ?? ""
);

const themeScript = `
  (() => {
    var cachedMode;

    try {
      var preferredTheme = JSON.parse(localStorage.getItem("${themeStorageKey}"));

      if (preferredTheme && preferredTheme.mode) {
        cachedMode = preferredTheme.mode;
      }
    } catch (err) { }

    const setTheme = (newTheme) => {
      document.documentElement.className = newTheme;
    };

    var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

    setTheme(cachedMode || (darkQuery.matches ? "dark" : "light"));
  })()
`;
---

<!doctype html>
<html lang="en" id="web">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={title} description={description} image={image} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />
    <meta name="theme-color" content="hsl(31, 92%, 62%)" />
    <link rel="icon" href="/icon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" sizes="48x48" href="/icon-48x48.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="96x96" href="/icon-96x96.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/icon-256x256.png" />
    <link rel="apple-touch-icon" sizes="384x384" href="/icon-384x384.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icon-512x512.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
    />
    <script
      is:inline
      set:html={`
        window.dataLayer = window.dataLayer || [];
        const gtag = (...args) => { dataLayer.push(args); };
        gtag("js", new Date());

        gtag("config", "${googleAnalyticsId}");
      `}
    />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <a href="#page" class="skip-link">
      Skip to content
    </a>
    <slot />
    <IconSprite />
  </body>
</html>

---
import "../assets/styles/main.scss";

import Gtag from "./gtag.astro";
import Meta from "./meta.astro";

import { themeStorageKey } from "@/utils/theme";

interface Props {
  description?: string;
  image?: string;
  title: string;
}

const { description = "", image, title } = Astro.props;

const canonicalPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const canonical = Astro.site
  ? new URL(canonicalPath, Astro.site).href
  : canonicalPath;

const themeScript = `
  void function() {
    var cachedMode;

    try {
      var preferredTheme = JSON.parse(localStorage.getItem("${themeStorageKey}"));

      if (preferredTheme && preferredTheme.mode) {
        cachedMode = preferredTheme.mode;
      }
    } catch (err) { }

    function setTheme(newTheme) {
      document.documentElement.className = newTheme;
    }

    var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

    setTheme(cachedMode || (darkQuery.matches ? "dark" : "light"));
  }()
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={title} description={description} image={image} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="anonymous" />
    <meta name="theme-color" content="hsl(31, 92%, 62%)" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" sizes="48x48" href="/icons/icon-48x48.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/icons/icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="96x96" href="/icons/icon-96x96.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icons/icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/icons/icon-256x256.png" />
    <link rel="apple-touch-icon" sizes="384x384" href="/icons/icon-384x384.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512x512.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <Gtag />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <slot />
  </body>
</html>

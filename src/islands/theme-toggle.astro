<button type="button" class="theme-switcher" data-theme-toggle aria-label="theme">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <title data-theme-title></title>
      <path
        pathLength="1"
        class="moon"
        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      />
      <path pathLength="1" class="sun" d="M12 7a5 5 0 1 0 0 10a5 5 0 1 0 0-10" />
      <path pathLength="1" class="sun" d="M12 1L12 3" />
      <path pathLength="1" class="sun" d="M12 21L12 23" />
      <path pathLength="1" class="sun" d="M4.22 4.22L5.64 5.64" />
      <path pathLength="1" class="sun" d="M18.36 18.36L19.78 19.78" />
      <path pathLength="1" class="sun" d="M1 12L3 12" />
      <path pathLength="1" class="sun" d="M21 12L23 12" />
      <path pathLength="1" class="sun" d="M4.22 19.78L5.64 18.36" />
      <path pathLength="1" class="sun" d="M18.36 5.64L19.78 4.22" />
    </svg>
</button>

<style lang="scss">
  .theme-switcher {
    --theme-switcher-color: hsl(var(--color-foreground));

    align-items: center;
    background: transparent;
    border: 0;
    outline: 0;
    display: flex;
    cursor: pointer;
    justify-content: center;

    svg {
      stroke: var(--theme-switcher-color);
      pointer-events: none;
      transition: stroke 400ms;
    }

    &:hover {
      --theme-switcher-color: hsl(var(--color-primary));
    }

    .moon {
      opacity: 0;
      stroke-dasharray: 0 1px;
      transition:
        stroke-dasharray 200ms ease-in,
        opacity 400ms ease-in;
    }

    .sun {
      opacity: 1;
      stroke-dasharray: 1px 1px;
      transition:
        stroke-dasharray 200ms ease-in,
        opacity 400ms ease-in;
    }
  }

  :global(html.dark) .theme-switcher {
    .moon {
      opacity: 1;
      stroke-dasharray: 1px 1px;
    }

    .sun {
      opacity: 0;
      stroke-dasharray: 0 1px;
    }
  }
</style>

<script>
  import { getTheme, toggleTheme } from "@/utils/theme";

  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]"
  );
  const title = document.querySelector<HTMLElement>("[data-theme-title]");

  const announce = (mode: string): void => {
    if (title) {
      title.textContent = mode;
    }

    if (button) {
      button.ariaLabel = mode;
    }
  };

  announce(getTheme().mode);

  button?.addEventListener("click", () => {
    announce(toggleTheme().mode);
  });
</script>

<div class="theme-switcher" data-theme-switcher>
  <button type="button" class="button" data-theme-toggle aria-label="theme">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <title data-theme-title></title>
      <path
        pathLength="1"
        class="moon"
        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      />
      <circle pathLength="1" class="sun" cx="12" cy="12" r="5" />
      <line pathLength="1" class="sun" x1="12" y1="1" x2="12" y2="3" />
      <line pathLength="1" class="sun" x1="12" y1="21" x2="12" y2="23" />
      <line pathLength="1" class="sun" x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line
        pathLength="1"
        class="sun"
        x1="18.36"
        y1="18.36"
        x2="19.78"
        y2="19.78"
      />
      <line pathLength="1" class="sun" x1="1" y1="12" x2="3" y2="12" />
      <line pathLength="1" class="sun" x1="21" y1="12" x2="23" y2="12" />
      <line
        pathLength="1"
        class="sun"
        x1="4.22"
        y1="19.78"
        x2="5.64"
        y2="18.36"
      />
      <line
        pathLength="1"
        class="sun"
        x1="18.36"
        y1="5.64"
        x2="19.78"
        y2="4.22"
      />
    </svg>
  </button>
</div>

<style lang="scss">
  .theme-switcher {
    --theme-switcher-color: hsl(var(--color-foreground));

    .button {
      align-items: center;
      background: transparent;
      border: 0;
      outline: 0;
      display: flex;
      cursor: pointer;
      justify-content: center;

      svg {
        stroke: var(--theme-switcher-color);
        pointer-events: none;
        transition: stroke 400ms;
      }

      &:hover {
        --theme-switcher-color: hsl(var(--color-primary));
      }
    }

    .moon {
      opacity: 0;
      stroke-dasharray: 0 1px;
      transition:
        stroke-dasharray 200ms ease-in,
        opacity 400ms ease-in;
    }

    .sun {
      opacity: 1;
      stroke-dasharray: 1px 1px;
      transition:
        stroke-dasharray 200ms ease-in,
        opacity 400ms ease-in;
    }
  }

  :global(html.dark) .theme-switcher {
    .moon {
      opacity: 1;
      stroke-dasharray: 1px 1px;
    }

    .sun {
      opacity: 0;
      stroke-dasharray: 0 1px;
    }
  }
</style>

<script>
  import { getTheme, toggleTheme } from "@/utils/theme";

  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]"
  );
  const title = document.querySelector<HTMLElement>("[data-theme-title]");

  const announce = (mode: string): void => {
    if (title) {
      title.textContent = mode;
    }

    if (button) {
      button.ariaLabel = mode;
    }
  };

  announce(getTheme().mode);

  button?.addEventListener("click", () => {
    announce(toggleTheme().mode);
  });
</script>

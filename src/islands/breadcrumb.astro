---
import styles from "@/assets/styles/modules/breadcrumb.module.scss";

import { labels } from "@/constants/labels";

import { Route, SLICE, toKebabCase } from "@/utils/routes";

interface Props {
  center?: boolean;
  className?: string;
  items: {
    href?: string;
    name: string;
  }[];
}

const { center = false, className, items } = Astro.props;
---

<nav
  id="breadcrumb"
  class={[styles.breadcrumb, center && styles.center, className]
    .filter(Boolean)
    .join(" ")}
  aria-label={labels.breadcrumb}
>
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;

        return (
          <li
            id={`breadcrumb-item-${toKebabCase(item.name)}`}
            aria-current={isLast ? "page" : undefined}
          >
            {isLast || !item.href ? (
              item.name
            ) : (
              <a href={new Route(item.href).anchor(SLICE.page)}>{item.name}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

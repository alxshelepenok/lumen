---
import { getCollection, render } from "astro:content";

import BaseLayout from "@/islands/base-layout.astro";
import Layout from "@/islands/layout.astro";
import Post from "@/islands/post.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { postGraph } from "@/utils/seo";
import { getSlug, getTagSlugs } from "@/utils/get-slug";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return posts.map((entry) => ({
    params: {
      slug: getSlug(entry.id, "posts")
        .replace(/^\/posts\/?/, "")
        .replace(/\/$/, ""),
    },
    props: { post: entry, slug: getSlug(entry.id, "posts").replace(/^\/posts\/?/, "").replace(/\/$/, "") },
  }));
}

const { post, slug } = Astro.props;
const { Content } = await render(post);

const { title, description } = getSiteMetadata();
const socialImage = post.data.socialImage;
const image =
  socialImage?.src && Astro.site
    ? new URL(socialImage.src, Astro.site).href
    : undefined;
const jsonLd = postGraph(slug, {
  date: post.data.date,
  description: post.data.description,
  tags: post.data.tags,
  title: post.data.title,
});
---

<BaseLayout
  title={`${post.data.title} - ${title}`}
  description={post.data.description || description}
  image={image}
  imageAlt={post.data.title}
  imageHeight={socialImage?.height}
  imageWidth={socialImage?.width}
  jsonLd={jsonLd}
  ogType="article"
  tags={post.data.tags}
>
  <Layout labelledBy="post-title" sidebar={false}>
    <Post
      post={{
        Content,
        date: post.data.date,
        tagSlugs: post.data.tags ? getTagSlugs(post.data.tags) : undefined,
        tags: post.data.tags,
        title: post.data.title,
      }}
    />
  </Layout>
</BaseLayout>

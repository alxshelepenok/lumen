---
import { getCollection, render } from "astro:content";

import pageStyles from "@/assets/styles/modules/page.module.scss";
import BaseLayout from "@/islands/base-layout.astro";
import Breadcrumb from "@/islands/breadcrumb.astro";
import Layout from "@/islands/layout.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { getSlug } from "@/utils/get-slug";
import { staticPageGraph } from "@/utils/seo";

export const getStaticPaths = async () => {
  const pages = await getCollection("pages", ({ data }) => !data.draft);

  return pages.map((entry) => ({
    params: {
      slug: getSlug(entry.id, "pages")
        .replace(/^\/pages\/?/, "")
        .replace(/\/$/, ""),
    },
    props: {
      page: entry,
      slug: getSlug(entry.id, "pages")
        .replace(/^\/pages\/?/, "")
        .replace(/\/$/, ""),
    },
  }));
}

const { page, slug } = Astro.props;
const { Content } = await render(page);

const { title, description } = getSiteMetadata();
const socialImage = page.data.socialImage;
const image =
  socialImage?.src && Astro.site
    ? new URL(socialImage.src, Astro.site).href
    : undefined;
const jsonLd = staticPageGraph(slug, {
  description: page.data.description,
  title: page.data.title,
});
---

<BaseLayout
  title={`${page.data.title} - ${title}`}
  description={page.data.description || description}
  image={image}
  imageAlt={page.data.title}
  imageHeight={socialImage?.height}
  imageWidth={socialImage?.width}
  jsonLd={jsonLd}
>
  <Layout>
    <article class={pageStyles.page} aria-labelledby="page-title">
      <header>
        <Breadcrumb items={[{ name: title, href: "/" }, { name: page.data.title }]} />
        <h1 id="page-title" class={pageStyles.title}>
          {page.data.title}
        </h1>
      </header>
      <section aria-labelledby="page-title">
        <Content />
      </section>
    </article>
  </Layout>
</BaseLayout>

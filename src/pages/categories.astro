---
import { getCollection } from "astro:content";

import BaseLayout from "@/islands/base-layout.astro";
import Layout from "@/islands/layout.astro";
import Page from "@/islands/page.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { categoryOf, getGroups } from "@/utils/get-taxonomy";
import { routes } from "@/utils/routes";

const { title, description } = getSiteMetadata();
const posts = await getCollection("posts", ({ data }) => !data.draft);
const categories = getGroups(posts, categoryOf);
---

<BaseLayout title={`Categories - ${title}`} description={description}>
  <Layout>
    <Page title="Categories">
      <ul>
        {
          categories.map((category) => (
            <li>
              <a href={routes.category(category.fieldValue).href()}>
                {category.fieldValue} ({category.totalCount})
              </a>
            </li>
          ))
        }
      </ul>
    </Page>
  </Layout>
</BaseLayout>

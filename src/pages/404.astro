---
import BaseLayout from "@/islands/base-layout.astro";
import Layout from "@/islands/layout.astro";
import Page from "@/islands/page.astro";

import { labels } from "@/constants/labels";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { SLICE, routes } from "@/utils/routes";

const { title, description } = getSiteMetadata();
---

<BaseLayout
  title={`${labels.notFound} - ${title}`}
  description={description}
  robots="noindex, follow"
>
  <Layout>
    <Page title={labels.notFound}>
      <p>You just hit a route that doesn't exist... the sadness.</p>
      <p>
        <a href={routes.home().anchor(SLICE.page)}>{labels.backToHomepage}</a>
      </p>
    </Page>
  </Layout>
</BaseLayout>

---
import { getCollection } from "astro:content";

import BaseLayout from "@/islands/base-layout.astro";
import Layout from "@/islands/layout.astro";
import Page from "@/islands/page.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { getGroups, tagsOf } from "@/utils/get-taxonomy";
import { routes } from "@/utils/routes";

const { title, description } = getSiteMetadata();
const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getGroups(posts, tagsOf);
---

<BaseLayout title={`Tags - ${title}`} description={description}>
  <Layout>
    <Page title="Tags">
      <ul>
        {
          tags.map((tag) => (
            <li>
              <a href={routes.tag(tag.fieldValue).href()}>
                {tag.fieldValue} ({tag.totalCount})
              </a>
            </li>
          ))
        }
      </ul>
    </Page>
  </Layout>
</BaseLayout>

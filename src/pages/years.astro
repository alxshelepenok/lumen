---
import { getCollection } from "astro:content";

import BaseLayout from "@/islands/base-layout.astro";
import Layout from "@/islands/layout.astro";
import Page from "@/islands/page.astro";
import Sidebar from "@/islands/sidebar.astro";

import { getSiteMetadata } from "@/utils/get-site-metadata";
import { getGroups, newestFirst, yearOf } from "@/utils/get-taxonomy";
import { routes } from "@/utils/routes";

const { title, description } = getSiteMetadata();
const posts = await getCollection("posts", ({ data }) => !data.draft);
const years = getGroups(posts, yearOf, newestFirst);
---

<BaseLayout title={`Years - ${title}`} description={description}>
  <Layout>
    <Sidebar />
    <Page title="Years">
      <ul>
        {
          years.map((year) => (
            <li>
              <a href={routes.year(year.fieldValue).href()}>
                {year.fieldValue} ({year.totalCount})
              </a>
            </li>
          ))
        }
      </ul>
    </Page>
  </Layout>
</BaseLayout>
